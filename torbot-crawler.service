[Unit]
Description=TorBot Dark Web Catalog Crawler
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/torbot-catalog
ExecStart=/home/ubuntu/tools/TorBot/.venv/bin/python /home/ubuntu/torbot-catalog/dark-web-crawler-v3.py --fast --threads 4 --max-children 50
Restart=always
RestartSec=30
MemoryMax=2G
CPUQuota=100%

[Install]
WantedBy=multi-user.target
